# Synora backend enterprise environment template
PROJECT_NAME="Synora"
ENVIRONMENT="development"
COOKIE_SECURE=False

# PostgreSQL is the production system of record.
DATABASE_URL="postgresql://synora_app:change-me@localhost:5432/synora"

SECRET_KEY="change-me-in-development"
ENCRYPTION_KEY="change-me-in-development"

GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/auth/google/callback"
GOOGLE_OAUTH_SCOPES='["openid","https://www.googleapis.com/auth/userinfo.email","https://www.googleapis.com/auth/userinfo.profile","https://www.googleapis.com/auth/meetings.space.readonly"]'
WORKSPACE_EVENTS_API_BASE="https://workspaceevents.googleapis.com"
MEET_TRANSCRIPT_EVENT_TYPE="google.workspace.meet.transcript.v2.fileGenerated"
PUBSUB_VERIFICATION_TOKEN=""

SLACK_BOT_TOKEN=""
SLACK_SIGNING_SECRET=""
FRONTEND_URL="http://localhost:3000"

# Primary semantic intelligence provider (Free Tier Default: Gemini)
LLM_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"

# Failover providers: NVIDIA NIM & Groq
NVIDIA_API_KEY=""
NVIDIA_MODEL="deepseek-ai/deepseek-v4.1-flash"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# Server-side Google Meet capture + post-meeting Sarvam STT
# Vexa captures audio only; Synora submits the completed recording to Sarvam.
VEXA_ENABLED="false"
VEXA_BASE_URL="http://localhost:18056"
VEXA_API_KEY=""
VEXA_BOT_NAME="Synora"
VEXA_POLL_INTERVAL_SECONDS="10"
VEXA_MAX_WAIT_SECONDS="14400"
VEXA_HTTP_TIMEOUT_SECONDS="30"
VEXA_RECORDING_DOWNLOAD_TIMEOUT_SECONDS="900"
SARVAM_API_KEY=""
SARVAM_STT_MODEL="saaras:v4"
SARVAM_STT_MODE="codemix"
SARVAM_WITH_DIARIZATION="true"
SARVAM_LANGUAGE_CODE=""
# SARVAM_NUM_SPEAKERS=2
SARVAM_KEYTERMS="Synora,Excalidraw,WhatsApp,Google Meet"
SARVAM_POLL_INTERVAL_SECONDS="5"
SARVAM_MAX_WAIT_SECONDS="3600"
SARVAM_HTTP_TIMEOUT_SECONDS="60"
SARVAM_UPLOAD_TIMEOUT_SECONDS="900"

# Self-hosted Whisper fallback. Used automatically only when Sarvam is unavailable or fails.
WHISPER_ENABLED="true"
WHISPER_MODEL="large-v3-turbo"
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE_TYPE="int8"
WHISPER_LANGUAGE_CODE=""
WHISPER_INITIAL_PROMPT=""
WHISPER_BEAM_SIZE="5"
WHISPER_VAD_FILTER="true"
WHISPER_CPU_THREADS="4"
WHISPER_MODEL_CACHE_DIR="/app/.cache/whisper"

# Strict Context Resolution Thresholds
CONTEXT_RESOLUTION_MIN_CONFIDENCE="0.72"
CONTEXT_RESOLUTION_MIN_MARGIN="0.08"
CONTEXT_RESOLUTION_AUTO_ASSIGN_MIN_CONFIDENCE="0.72"

# WhatsApp live one-minute batching
WHATSAPP_PROCESSING_INTERVAL_SECONDS="60"
WHATSAPP_BATCH_POLL_SECONDS="5"
WHATSAPP_BATCH_MAX_MESSAGES="100"
WHATSAPP_BATCH_MAX_RETRIES="3"
WHATSAPP_BATCH_RETRY_SECONDS="15"
WHATSAPP_CONTEXT_WINDOW_SIZE="6"
