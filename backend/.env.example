# ==============================================================================
# Synesis Enterprise Integration & Backend Environment Configuration (.env.example)
# ==============================================================================

# Application & Environment
PROJECT_NAME="Synesis"
ENVIRONMENT="development"
COOKIE_SECURE=False

# Database
DATABASE_URL="sqlite:///./synesis.db"

# Security & Encryption Secrets
SECRET_KEY="synesis-secret-key-change-in-production-random-bytes"
ENCRYPTION_KEY="synesis-encryption-passphrase-change-in-production-secure"

# ------------------------------------------------------------------------------
# 1. Google Meet (Native Cloud REST API v2 + OAuth 2.0)
# Event-driven pipeline: Workspace Events (notification) -> Pub/Sub (delivery)
# -> Synesis worker -> Meet REST API (transcript retrieval).
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/auth/google/callback"

# Google Workspace Events API (notification infrastructure only)
WORKSPACE_EVENTS_API_BASE="https://workspaceevents.googleapis.com"
MEET_TRANSCRIPT_EVENT_TYPE="google.workspace.meet.transcript.v2.fileGenerated"

# Google Cloud Pub/Sub push verification (shared Bearer token for /pubsub/meet-events)
PUBSUB_VERIFICATION_TOKEN=""

# ------------------------------------------------------------------------------
# 2. Slack (Official Slack App Bot & Events API)
# ------------------------------------------------------------------------------
SLACK_BOT_TOKEN="xoxb-your-bot-token"
SLACK_SIGNING_SECRET="your-slack-signing-secret"

# ------------------------------------------------------------------------------
# 3. Excalidraw (Visual Architecture Scene Synchronization)
# ------------------------------------------------------------------------------
# Open format: application/vnd.excalidraw+json (Role A Import / Role B Export)

# Frontend URL
FRONTEND_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. NVIDIA NIM (DeepSeek AI Intelligence Engine)
# ------------------------------------------------------------------------------
LLM_PROVIDER="nvidia"
NVIDIA_API_KEY="" # Paste your nvapi-... key here from build.nvidia.com
NVIDIA_MODEL="deepseek-ai/deepseek-v4.1-flash"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

